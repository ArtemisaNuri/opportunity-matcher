{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [],
    "typeRoots": [],
    "paths": { "@/*": ["../*"] }
  },
  "include": ["types/*.d.ts", "../app/**/*.ts", "../app/**/*.tsx", "../components/**/*.ts", "../components/**/*.tsx", "../lib/**/*.ts", "../lib/**/*.tsx"]
}
